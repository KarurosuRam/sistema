<section class="explore-head">
  <div class="container">
    <p class="eyebrow eyebrow--center">Historias que siguen vivas</p>
    <h1>Memoriales <span class="display-italic">compartidos</span></h1>
    <p class="lede">Familias de todo Chile han abierto un espacio para recordar. Visita sus memoriales, deja un mensaje o enciende una vela.</p>
  </div>
</section>

<section class="section section--tight" style="padding-top: 10px;">
  <div class="container">
    <form class="explore-search reveal" action="/memoriales" method="get" role="search">
      <div class="explore-search__field">
        <%- icon('search', 18) %>
        <input class="input" type="search" name="q" value="<%= query %>" maxlength="80" placeholder="Buscar por nombre, relación o frase…" aria-label="Buscar memoriales">
      </div>
      <div class="explore-search__filters" role="group" aria-label="Filtrar por tipo">
        <label class="explore-chip <%= !kind ? 'is-active' : '' %>"><input type="radio" name="tipo" value="" <%= !kind ? 'checked' : '' %>>Todos</label>
        <label class="explore-chip <%= kind === 'persona' ? 'is-active' : '' %>"><input type="radio" name="tipo" value="persona" <%= kind === 'persona' ? 'checked' : '' %>>Personas</label>
        <label class="explore-chip <%= kind === 'mascota' ? 'is-active' : '' %>"><input type="radio" name="tipo" value="mascota" <%= kind === 'mascota' ? 'checked' : '' %>>Mascotas</label>
      </div>
      <button class="btn" type="submit">Buscar</button>
    </form>

    <% if (query) { %>
      <div class="explore-results reveal">
        <span><strong><%= helpers.formatNumber(total) %></strong> <%= total === 1 ? 'memorial encontrado' : 'memoriales encontrados' %> para «<%= query %>»<%= kind ? (kind === 'mascota' ? ' · solo mascotas' : ' · solo personas') : '' %></span>
        <a class="link-arrow" href="/memoriales" style="font-size: 0.66rem;">Limpiar búsqueda <%- icon('close', 13) %></a>
      </div>
    <% } %>

    <% if (!memorials.length) { %>
      <div class="empty-state">
        <%- icon('flower', 42) %>
        <h3><%= query ? 'No encontramos memoriales con esos términos' : 'El jardín está empezando a florecer' %></h3>
        <p><%= query ? 'Prueba con otro nombre o revisa la ortografía. También puedes explorar todos los memoriales.' : 'Todavía no hay memoriales públicos. Sé de las primeras familias en compartir una historia.' %></p>
        <a class="btn" href="<%= query ? '/memoriales' : '/registro' %>"><%= query ? 'Ver todos los memoriales' : 'Crear un memorial' %></a>
      </div>
    <% } else { %>
      <div class="memorial-grid">
        <% memorials.forEach(function (memorial) { %>
          <%- include('partials/memorial-card', { memorial: memorial }) %>
        <% }); %>
      </div>

      <% if (pages > 1) { %>
        <nav class="pagination" aria-label="Paginación de memoriales">
          <% for (var i = 1; i <= pages; i += 1) { %>
            <% if (i === page) { %>
              <span class="is-current" aria-current="page"><%= i %></span>
            <% } else { %>
              <a href="/memoriales?page=<%= i %><%= query ? '&q=' + encodeURIComponent(query) : '' %><%= kind ? '&tipo=' + kind : '' %>"><%= i %></a>
            <% } %>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <div class="cta-final reveal">
      <div>
        <h2>La próxima historia puede ser la tuya</h2>
        <p>Crea un memorial para tu ser querido o mascota. En minutos tendrás un lugar para recordar y compartir.</p>
      </div>
      <div class="cta-final__actions">
        <a class="btn btn--light btn--block" href="/registro">Crear mi memorial</a>
        <a class="btn btn--ghost btn--block" href="/planes">Ver precios</a>
      </div>
    </div>
  </div>
</section>
