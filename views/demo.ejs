<div class="demo-bar">
  <a class="demo-bar__brand" href="/" target="_parent">
    <%- brandMark(26) %>
    <span>Jardín Memorial</span>
  </a>
  <span class="demo-bar__tag">Demo</span>
</div>

<section class="demo-page">
  <div class="container demo-page__inner">
    <header class="demo-page__head">
      <p class="demo-page__badge"><%- icon('sparkles', 13) %> Demo interactiva</p>
      <h1 class="demo-page__title">Prueba Jardín Memorial <em>sin crear cuenta</em></h1>
      <p class="demo-page__lede">
        Todo lo que hagas aquí ocurre con datos de ejemplo y se queda en esta misma pantalla:
        enciende velas, deja un mensaje, cambia el tema o crea un memorial de prueba.
      </p>
    </header>

    <% if (!locals.demoAvailable) { %>
      <div class="demo-note demo-note--warn" role="status">
        La demo no está disponible en esta instalación. Puedes recorrer los memoriales públicos mientras tanto.
        <a href="/memoriales" target="_parent">Ver memoriales</a>
      </div>
    <% } else { %>

      <% if (locals.status) { %>
        <p class="demo-note demo-note--ok" role="status"><%- icon('check-circle', 15) %> <%= locals.status %></p>
      <% } %>
      <% if (locals.error) { %>
        <p class="demo-note demo-note--warn" role="alert"><%- icon('alert-circle', 15) %> <%= locals.error %></p>
      <% } %>

      <section class="demo-block" aria-labelledby="demo-memoriales">
        <div class="demo-block__head">
          <h2 id="demo-memoriales">Memoriales de la cuenta</h2>
          <span class="demo-block__count"><%= memorials.length %> de <%= maxMemorials %></span>
        </div>

        <div class="demo-chips" role="list">
          <% memorials.forEach(function (item) { %>
            <a
              class="demo-chip<%= selected && item.slug === selected.slug ? ' is-active' : '' %>"
              href="/demo?m=<%= item.slug %>#demo-memoriales"
              role="listitem"
            >
              <span class="demo-chip__media">
                <% if (item.main_thumb || item.main_photo) { %>
                  <img src="/uploads/<%= item.main_thumb || item.main_photo %>" alt="" loading="lazy">
                <% } else { %>
                  <span class="demo-chip__monogram"><%= helpers.initials(item.full_name) %></span>
                <% } %>
              </span>
              <span class="demo-chip__name"><%= item.full_name %></span>
            </a>
          <% }); %>
        </div>
      </section>

      <% if (selected) { %>
        <section class="demo-preview theme-<%= selected.theme %>" aria-labelledby="demo-preview-title">
          <div class="demo-preview__cover">
            <% if (selected.main_photo) { %>
              <img src="/uploads/<%= selected.main_photo %>" alt="Retrato de <%= selected.full_name %>" loading="lazy">
            <% } else { %>
              <span class="demo-preview__monogram"><%= helpers.initials(selected.full_name) %></span>
            <% } %>
          </div>

          <div class="demo-preview__body">
            <p class="demo-preview__eyebrow"><%= selected.kind === 'mascota' ? 'En memoria de su mascota' : 'En memoria de' %></p>
            <h2 id="demo-preview-title" class="demo-preview__name"><%= selected.full_name %></h2>
            <% if (locals.yearsLabel) { %>
              <p class="demo-preview__years">
                <%= locals.yearsLabel %>
                <% if (locals.lifeYears) { %><span>· <%= locals.lifeYears %> años</span><% } %>
              </p>
            <% } %>
            <% if (selected.epitaph) { %>
              <p class="demo-preview__epitaph">“<%= selected.epitaph %>”</p>
            <% } %>

            <ul class="demo-preview__stats">
              <li><%- icon('image', 13) %> <%= selected.photo_count || photos.length %> fotos</li>
              <li><%- icon('message', 13) %> <%= helpers.formatNumber(messageCount) %> mensajes</li>
              <li><%- icon('flame', 13) %> <%= helpers.formatNumber(candleCount) %> velas</li>
              <li>
                <%- icon(selected.is_public ? 'globe' : 'lock', 13) %>
                <%= selected.is_public ? 'Público' : 'Privado' %>
              </li>
            </ul>

            <div class="demo-preview__actions">
              <a class="btn btn--sm" href="/m/<%= selected.slug %>" target="_parent">
                Ver la página completa <%- icon('arrow-right', 13) %>
              </a>
              <a class="link-arrow" href="/demo?m=<%= selected.slug %>#ajustes">Administrar</a>
            </div>
          </div>
        </section>

        <% if (photos.length) { %>
          <div class="demo-gallery" aria-label="Fotos del memorial">
            <% photos.slice(0, 6).forEach(function (photo) { %>
              <span class="demo-gallery__item">
                <img src="/uploads/<%= photo.thumb || photo.filename %>" alt="" loading="lazy">
              </span>
            <% }); %>
          </div>
        <% } %>

        <section class="demo-block demo-block--split" id="velas" aria-labelledby="demo-velas">
          <div>
            <h2 id="demo-velas">Enciende una vela</h2>
            <p>Llevas <strong><%= helpers.formatNumber(candleCount) %></strong> <%= candleCount === 1 ? 'vela' : 'velas' %> encendidas en este memorial.</p>
          </div>
          <% if (selected.allow_guestbook) { %>
            <form class="demo-form demo-form--inline" action="/demo/vela" method="post">
              <input type="hidden" name="slug" value="<%= selected.slug %>">
              <label class="visually-hidden" for="demo-candle-name">Tu nombre</label>
              <input class="input" type="text" id="demo-candle-name" name="name" maxlength="60" placeholder="Tu nombre (opcional)">
              <button class="btn btn--sm" type="submit"><%- icon('flame', 14) %> Encender</button>
            </form>
          <% } else { %>
            <p class="demo-block__muted">La familia cerró las velas de este memorial.</p>
          <% } %>
        </section>

        <section class="demo-block demo-block--split" id="libro" aria-labelledby="demo-libro">
          <div>
            <h2 id="demo-libro">Libro de visitas</h2>
            <p>Deja unas palabras y mira cómo se arma la memoria compartida.</p>
          </div>

          <% if (selected.allow_guestbook) { %>
            <form class="demo-form" action="/demo/firma" method="post">
              <input type="hidden" name="slug" value="<%= selected.slug %>">
              <div class="field-grid">
                <div class="field">
                  <label for="demo-guest-name">Tu nombre</label>
                  <input class="input" type="text" id="demo-guest-name" name="name" maxlength="60" required placeholder="María José">
                </div>
                <div class="field">
                  <label for="demo-guest-city">Ciudad <span class="hint">(opcional)</span></label>
                  <input class="input" type="text" id="demo-guest-city" name="city" maxlength="60" placeholder="Santiago">
                </div>
              </div>
              <div class="field">
                <label for="demo-guest-message">Tu mensaje</label>
                <textarea class="textarea" id="demo-guest-message" name="message" maxlength="600" required placeholder="Un recuerdo, una anécdota, unas palabras de cariño…"></textarea>
              </div>
              <button class="btn btn--sm" type="submit"><%- icon('send', 14) %> Dejar mi mensaje</button>
            </form>
          <% } else { %>
            <p class="demo-block__muted">El libro de visitas está cerrado en este memorial.</p>
          <% } %>

          <% if (guestbook.length) { %>
            <ul class="demo-messages">
              <% guestbook.forEach(function (entry) { %>
                <li class="demo-message">
                  <span class="demo-message__avatar"><%= helpers.initials(entry.name) %></span>
                  <div>
                    <strong><%= entry.name %><% if (entry.city) { %> <span>· <%= entry.city %></span><% } %></strong>
                    <p><%= helpers.truncate(entry.message, 180) %></p>
                  </div>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </section>

        <section class="demo-block" id="ajustes" aria-labelledby="demo-ajustes">
          <div class="demo-block__head">
            <h2 id="demo-ajustes">Administración</h2>
            <span class="demo-block__count">Como en tu panel</span>
          </div>

          <div class="demo-admin">
            <form class="demo-admin__row" action="/demo/tema" method="post">
              <input type="hidden" name="slug" value="<%= selected.slug %>">
              <div class="demo-admin__label">
                <strong>Tema del memorial</strong>
                <span>Ahora: <%= themes[selected.theme] ? themes[selected.theme].name : 'Jardín' %></span>
              </div>
              <div class="demo-themes">
                <% Object.keys(themes).forEach(function (key) { %>
                  <button
                    class="demo-theme theme-<%= key %><%= selected.theme === key ? ' is-active' : '' %>"
                    type="submit"
                    name="theme"
                    value="<%= key %>"
                    aria-pressed="<%= selected.theme === key ? 'true' : 'false' %>"
                  >
                    <span class="demo-theme__dot"></span><%= themes[key].name %>
                  </button>
                <% }); %>
              </div>
            </form>

            <div class="demo-admin__row">
              <div class="demo-admin__label">
                <strong>Visibilidad</strong>
                <span><%= selected.is_public ? 'Aparece en la galería pública' : 'Solo con el enlace directo' %></span>
              </div>
              <form action="/demo/visibilidad" method="post">
                <input type="hidden" name="slug" value="<%= selected.slug %>">
                <button class="btn btn--ghost btn--sm" type="submit">
                  <%- icon(selected.is_public ? 'lock' : 'globe', 14) %>
                  <%= selected.is_public ? 'Hacerlo privado' : 'Hacerlo público' %>
                </button>
              </form>
            </div>

            <div class="demo-admin__row">
              <div class="demo-admin__label">
                <strong>Libro de visitas</strong>
                <span><%= selected.allow_guestbook ? 'Abierto a mensajes y velas' : 'Cerrado por la familia' %></span>
              </div>
              <form action="/demo/libro" method="post">
                <input type="hidden" name="slug" value="<%= selected.slug %>">
                <button class="btn btn--ghost btn--sm" type="submit">
                  <%- icon(selected.allow_guestbook ? 'lock' : 'book', 14) %>
                  <%= selected.allow_guestbook ? 'Cerrarlo' : 'Abrirlo' %>
                </button>
              </form>
            </div>

            <% if (locals.selectedIsDemoCreated) { %>
              <div class="demo-admin__row">
                <div class="demo-admin__label">
                  <strong>Memorial de prueba</strong>
                  <span>Lo creaste en esta demo; puedes retirarlo sin tocar los ejemplos.</span>
                </div>
                <form action="/demo/eliminar" method="post">
                  <input type="hidden" name="slug" value="<%= selected.slug %>">
                  <button class="btn btn--ghost btn--sm" type="submit">
                    <%- icon('trash', 14) %> Quitar de la demo
                  </button>
                </form>
              </div>
            <% } %>
          </div>
        </section>

        <section class="demo-block" id="crear" aria-labelledby="demo-crear">
          <div class="demo-block__head">
            <h2 id="demo-crear">Crea un memorial de prueba</h2>
            <span class="demo-block__count">Sin costo</span>
          </div>
          <p class="demo-block__muted">Se crea privado, como en tu panel, y puedes administrarlo aquí mismo.</p>

          <% if (memorials.length >= maxMemorials) { %>
            <p class="demo-block__muted">La demo llegó a su máximo de memoriales. Quita uno de los que creaste para seguir probando.</p>
          <% } else { %>
            <form class="demo-form" action="/demo/crear" method="post">
              <div class="field-grid">
                <div class="field">
                  <label for="demo-new-name">Nombre</label>
                  <input class="input" type="text" id="demo-new-name" name="full_name" maxlength="90" required placeholder="Nombre de quien recuerdas">
                </div>
                <div class="field">
                  <label for="demo-new-kind">Es para</label>
                  <select class="input" id="demo-new-kind" name="kind">
                    <option value="persona">Una persona</option>
                    <option value="mascota">Una mascota</option>
                  </select>
                </div>
              </div>
              <button class="btn btn--sm" type="submit"><%- icon('plus', 14) %> Crear memorial de prueba</button>
            </form>
          <% } %>
        </section>
      <% } else { %>
        <p class="demo-note demo-note--warn" role="status">
          La cuenta de ejemplo todavía no tiene memoriales.
          <a href="#crear">Crea el primero</a>.
        </p>
      <% } %>

      <footer class="demo-page__foot">
        <p>
          Esta es una demostración con datos de ejemplo. Para tener tu propio jardín, con enlace único,
          QR y certificado, <a href="/registro" target="_parent">crea tu cuenta</a>.
        </p>
      </footer>
    <% } %>
  </div>
</section>
