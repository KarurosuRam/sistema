<section class="auth">
  <div class="auth__panel">
    <div class="auth__inner">
      <p class="eyebrow">Bienvenido de vuelta</p>
      <h1>Ingresa a tu jardín</h1>
      <p class="lede">Continúa cuidando los memoriales de quienes quieres.</p>

      <% if (errors.length) { %>
        <div class="form-errors" role="alert">
          <%- icon('alert-circle', 18) %>
          <ul>
            <% errors.forEach(function (error) { %><li><%= error %></li><% }); %>
          </ul>
        </div>
      <% } %>

      <form action="/ingresar" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>

        <div class="field">
          <label for="email">Correo electrónico</label>
          <input class="input" type="email" id="email" name="email" autocomplete="email" required value="<%= values.email || '' %>" placeholder="tu@correo.cl" autofocus>
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <input class="input" type="password" id="password" name="password" autocomplete="current-password" required placeholder="Tu contraseña">
        </div>

        <button class="btn btn--block btn--lg" type="submit">Ingresar <%- icon('arrow-right', 16) %></button>
      </form>

      <% if (config.paymentsMode === 'demo') { %>
        <div class="demo-note" style="margin-top: 20px; text-align: left;">
          <%- icon('info', 16) %>
          <div>
            <strong style="display: block; color: var(--sage-deep); font-weight: 500;">Cuenta de demostración</strong>
            Correo: <span class="serif">demo@jardinmemorial.cl</span><br>
            Contraseña: <span class="serif">jardin2026</span>
          </div>
        </div>
      <% } %>

      <% if (demoAccess) { %>
        <p class="auth__alt"><a href="/probar?entrar=1">Entrar directo a la demo</a> sin escribir la contraseña</p>
      <% } %>
      <p class="auth__alt">¿Aún no tienes cuenta? <a href="/registro">Crea tu cuenta gratis</a></p>

      <div class="auth__trust">
        <span><%- icon('shield', 14) %> Sesión segura</span>
        <span><%- icon('lock', 14) %> Contraseña cifrada</span>
      </div>
    </div>
  </div>

  <aside class="auth__visual" aria-hidden="true">
    <img src="/img/demo-tea.jpg" alt="">
    <div class="auth__quote">
      <p>“Volver a este lugar es volver a sentir que sigue cerca.”</p>
      <span>Una familia de Jardín Memorial</span>
    </div>
  </aside>
</section>
