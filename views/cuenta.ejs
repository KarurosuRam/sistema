<section class="panel-shell">
  <div class="container">
    <div class="dash-head">
      <div>
        <p class="eyebrow">Mi cuenta</p>
        <h1>Hola, <%= user.name.split(' ')[0] %></h1>
        <p><%= user.email %> · Miembro desde <%= helpers.formatTimestamp(user.created_at) %></p>
      </div>
      <form action="/salir" method="post">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost btn--sm" type="submit"><%- icon('logout', 15) %> Cerrar sesión</button>
      </form>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-card__icon"><%- icon('leaf', 17) %></span>
        <div><span class="stat-card__value"><%= user.credits %></span><span class="stat-card__label">Memoriales disponibles</span></div>
      </div>
      <div class="stat-card">
        <span class="stat-card__icon"><%- icon('flower', 17) %></span>
        <div><span class="stat-card__value"><%= memorialCount %></span><span class="stat-card__label">Memoriales creados</span></div>
      </div>
      <div class="stat-card">
        <span class="stat-card__icon"><%- icon('card', 17) %></span>
        <div><span class="stat-card__value"><%= purchases.length %></span><span class="stat-card__label">Compras realizadas</span></div>
      </div>
      <div class="stat-card">
        <span class="stat-card__icon"><%- icon('shield', 17) %></span>
        <div><span class="stat-card__value">Activa</span><span class="stat-card__label">Cuenta verificada</span></div>
      </div>
    </div>

    <div class="create-layout">
      <div>
        <div class="form-card">
          <div class="form-card__head">
            <h2>Mis datos</h2>
            <span>Perfil</span>
          </div>

          <% if (errors.length) { %>
            <div class="form-errors" role="alert"><%- icon('alert-circle', 18) %><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
          <% } %>

          <form action="/cuenta" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="name">Nombre completo</label>
              <input class="input" type="text" id="name" name="name" value="<%= values.name %>" maxlength="80" required>
            </div>
            <div class="field">
              <label for="email-display">Correo electrónico</label>
              <input class="input" type="email" id="email-display" value="<%= user.email %>" disabled>
              <p class="hint">El correo identifica tu cuenta y no se puede cambiar en línea.</p>
            </div>
            <div style="display: flex; justify-content: flex-end;">
              <button class="btn" type="submit">Guardar cambios</button>
            </div>
          </form>
        </div>

        <div class="form-card">
          <div class="form-card__head">
            <h2>Contraseña</h2>
            <span>Seguridad</span>
          </div>

          <% if (pwdErrors.length) { %>
            <div class="form-errors" role="alert"><%- icon('alert-circle', 18) %><ul><% pwdErrors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
          <% } %>

          <form action="/cuenta/contrasena" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label for="current_password">Contraseña actual</label>
              <input class="input" type="password" id="current_password" name="current_password" autocomplete="current-password" required>
            </div>
            <div class="field-grid">
              <div class="field">
                <label for="new_password">Nueva contraseña</label>
                <input class="input" type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="8" required>
              </div>
              <div class="field">
                <label for="new_password_confirm">Repite la nueva</label>
                <input class="input" type="password" id="new_password_confirm" name="new_password_confirm" autocomplete="new-password" minlength="8" required>
              </div>
            </div>
            <div style="display: flex; justify-content: flex-end;">
              <button class="btn btn--ghost" type="submit">Cambiar contraseña</button>
            </div>
          </form>
        </div>
      </div>

      <div class="side-stack">
        <div class="info-tile">
          <h4>Memoriales disponibles</h4>
          <span class="big"><%= user.credits %></span>
          <p>Cada memorial que creas descuenta uno de tus cupos. Compra más cuando los necesites.</p>
          <a class="btn btn--sm" href="/panel/planes" style="margin-top: 14px;">Comprar memoriales</a>
        </div>

        <div class="info-tile">
          <h4>Historial de compras</h4>
          <% if (!purchases.length) { %>
            <p>Todavía no tienes compras. Puedes elegir un plan cuando estés listo.</p>
          <% } else { %>
            <div style="display: grid; gap: 12px; margin-top: 6px;">
              <% purchases.slice(0, 5).forEach(function (purchase) { %>
                <div style="display: flex; justify-content: space-between; gap: 10px; font-size: 0.8rem;">
                  <span><%= purchase.plan_name %><br><span class="tiny muted"><%= helpers.formatTimestamp(purchase.created_at) %></span></span>
                  <strong style="font-weight: 500; color: var(--ink);"><%= helpers.formatCLP(purchase.amount) %></strong>
                </div>
              <% }); %>
            </div>
            <a class="link-arrow" href="/panel/compras" style="margin-top: 16px; font-size: 0.66rem;">Ver todo <%- icon('arrow-right', 14) %></a>
          <% } %>
        </div>

        <div class="info-tile">
          <h4>¿Necesitas ayuda?</h4>
          <p>Escríbenos a <a class="text-link" href="mailto:<%= site.email %>"><%= site.email %></a> y te respondemos dentro de 24 horas hábiles.</p>
        </div>
      </div>
    </div>
  </div>
</section>
