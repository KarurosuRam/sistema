<section class="panel-shell">
  <div class="container">
    <div class="dash-head">
      <div>
        <p class="eyebrow">Finalizar compra</p>
        <h1><%= plan.name %></h1>
        <p>Revisa el detalle y confirma tu pago para agregar <%= plan.credits %> <%= plan.credits === 1 ? 'memorial' : 'memoriales' %> a tu cuenta.</p>
      </div>
      <a class="btn btn--ghost" href="/panel/planes">Cambiar plan</a>
    </div>

    <div class="checkout-layout">
      <div class="form-card">
        <% if (paymentsMode === 'demo') { %>
          <div class="demo-note" style="margin-top: 0; margin-bottom: 22px;">
            <%- icon('info', 16) %>
            <span>Esta es una compra de demostración. No se solicita ni se procesa ningún dato de tarjeta real.</span>
          </div>
        <% } %>

        <div class="form-card__head">
          <h2>Datos del titular</h2>
          <span>Cuenta</span>
        </div>
        <div class="field-grid">
          <div class="field">
            <label for="holder">Nombre</label>
            <input class="input" type="text" id="holder" value="<%= user.name %>" disabled>
          </div>
          <div class="field">
            <label for="holder-email">Correo</label>
            <input class="input" type="email" id="holder-email" value="<%= user.email %>" disabled>
          </div>
        </div>

        <div class="pay-method">
          <%- icon('card', 22) %>
          <div>
            <strong>Pago con tarjeta</strong>
            <span>Transacción protegida · Webpay / Mercado Pago</span>
          </div>
        </div>

        <% if (paymentsMode === 'demo') { %>
          <div class="card-demo" aria-hidden="true">
            <div class="card-demo__row">
              <span>JARDÍN MEMORIAL</span>
              <span>DEMO</span>
            </div>
            <div class="card-demo__number">•••• •••• •••• 2026</div>
            <div class="card-demo__foot">
              <span><%= user.name %></span>
              <span>12 / 30</span>
            </div>
          </div>
        <% } else { %>
          <div class="field">
            <label for="card-number">Número de tarjeta</label>
            <input class="input" type="text" id="card-number" inputmode="numeric" autocomplete="cc-number" placeholder="0000 0000 0000 0000">
          </div>
          <div class="field-grid">
            <div class="field">
              <label for="card-exp">Vencimiento</label>
              <input class="input" type="text" id="card-exp" autocomplete="cc-exp" placeholder="MM/AA">
            </div>
            <div class="field">
              <label for="card-cvv">CVV</label>
              <input class="input" type="text" id="card-cvv" autocomplete="cc-csc" placeholder="123">
            </div>
          </div>
          <p class="hint">Los datos de tu tarjeta se procesan directamente en la pasarela de pagos; no se almacenan en nuestros servidores.</p>
        <% } %>

        <form action="/panel/comprar/<%= plan.id %>" method="post" style="margin-top: 10px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--block btn--lg" type="submit">
            <%- icon('lock', 16) %> Confirmar pago de <%= helpers.formatCLP(plan.amount) %>
          </button>
        </form>
        <p class="hint" style="text-align: center; margin-top: 12px;">Al confirmar aceptas los <a class="text-link" href="/terminos">términos y condiciones</a> del servicio.</p>
      </div>

      <aside class="order-card">
        <h3>Resumen del pedido</h3>
        <div class="order-row"><span>Plan</span><span><%= plan.name %></span></div>
        <div class="order-row"><span>Memoriales incluidos</span><span><%= plan.credits %></span></div>
        <div class="order-row"><span>Vigencia</span><span>Permanente</span></div>
        <div class="order-row"><span>Certificado de propiedad</span><span><%= plan.credits %> incluido<%= plan.credits === 1 ? '' : 's' %></span></div>
        <div class="order-row"><span>Subtotal</span><span><%= helpers.formatCLP(plan.amount) %></span></div>
        <div class="order-total">
          <span>Total a pagar</span>
          <strong><%= helpers.formatCLP(plan.amount) %></strong>
        </div>
        <ul class="price-card__list" style="border-top: 1px solid var(--line); margin-top: 20px; font-size: 0.8rem;">
          <li><%- icon('check', 15) %> Enlace único y QR por memorial</li>
          <li><%- icon('check', 15) %> Galería de 10 fotos</li>
          <li><%- icon('check', 15) %> Video de hasta 60 segundos</li>
          <li><%- icon('check', 15) %> Música MP3 al abrir</li>
          <li><%- icon('check', 15) %> Libro de visitas y velas</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
