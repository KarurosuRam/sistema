# ============================================================================
# Jardín Memorial + WordPress · variables de docker compose
# Copia este archivo como .env y completa los valores.
# ============================================================================

# Dominio del sitio WordPress (con www si ese es el dominio público).
WORDPRESS_DOMAIN=www.jardinmemorial.cl

# Dominio de la app de memoriales. Debe ser un subdominio del mismo dominio
# registrable para que las cookies de sesión sean "same-site" dentro del iframe.
APP_DOMAIN=memoriales.jardinmemorial.cl

# Correo para los certificados TLS de Caddy (Let's Encrypt).
ACME_EMAIL=hola@jardinmemorial.cl

# --- Base de datos de WordPress ---------------------------------------------
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-otra-clave

# --- Pagos Flow --------------------------------------------------------------
# flow = cobros reales · demo = simulado
PAYMENTS_MODE=flow
# sandbox = pruebas · production = cobros reales
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=

# --- Datos de la app ---------------------------------------------------------
# No sembrar memoriales de ejemplo en una instalación real.
SEED_DEMO=false
DEMO_ACCESS=off

# Opcional: compartir cookies entre subdominios del mismo sitio.
# COOKIE_DOMAIN=.jardinmemorial.cl
