# ============================================================================
# Jardín Memorial · configuración de producción
# Copia este archivo como .env en la carpeta del proyecto: la app lo lee sola al
# arrancar (node >= 20.12). Las variables ya definidas en el entorno tienen
# prioridad, así que en Docker o systemd manda lo que pase el servicio.
# Nunca lo subas al repositorio. Las variables del entorno tienen prioridad.
# ============================================================================

# --- Sitio ------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# URL pública REAL de la app (debe ser HTTPS y accesible desde internet).
# Es la que la pasarela usa para devolver al comprador y para notificar el pago.
SITE_URL=https://memoriales.jardinmemorial.cl

# Dominio(s) del sitio WordPress que pueden incrustar la app en un iframe.
# Varios valores separados por coma o espacio.
EMBED_ORIGINS=https://www.jardinmemorial.cl

# 1 = oculta siempre el encabezado y el pie propios de la app. Normalmente 0:
# con la plantilla de pantalla completa de WordPress la app aporta la
# navegación; si la página conserva el encabezado del tema, usa chrome="0" en
# el shortcode en lugar de esta variable.
EMBED_CHROME=0

# --- Pagos ------------------------------------------------------------------
# Pasarela activa:
#   mercadopago = cobros reales con Mercado Pago Checkout Pro (recomendado)
#   flow        = cobros reales con Flow (si ya tienes comercio ahí)
#   demo        = pagos simulados, sin cargo real
# Si no se define, se usa Mercado Pago cuando hay credenciales, luego Flow y,
# si no hay ninguna, el modo demostración.
PAYMENTS_MODE=mercadopago

# --- Mercado Pago -----------------------------------------------------------
# 1. Crea tu cuenta en https://www.mercadopago.cl
# 2. Entra a https://www.mercadopago.cl/developers/panel/app y crea una
#    aplicación (o abre la existente) → Credenciales.
# 3. Copia el Access Token. El de PRUEBAS empieza con TEST- y el de producción
#    con APP_USR-. Empieza con pruebas y cambia a producción al cobrar de verdad.
MP_ACCESS_TOKEN=
# sandbox = pruebas · production = cobros reales
MP_ENV=sandbox

# Secreto de firma del webhook (Mercado Pago → Webhooks → Configurar
# notificación → Clave secreta). Es opcional, pero recomendado: permite
# comprobar que la notificación viene de Mercado Pago. Aunque no se defina, la
# app siempre consulta el pago real a la API antes de acreditar cupos.
MP_WEBHOOK_SECRET=

# Solo para pruebas automatizadas con un Mercado Pago simulado.
# MP_API_URL=http://127.0.0.1:3901

# --- Flow (alternativa) -----------------------------------------------------
# sandbox = pruebas · production = cobros reales
FLOW_ENV=sandbox

# Credenciales de tu comercio Flow:
#   producción → https://www.flow.cl/app/web/misDatos.php
#   pruebas    → https://sandbox.flow.cl/app/web/misDatos.php
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Solo para pruebas automatizadas con un Flow simulado.
# FLOW_API_URL=http://127.0.0.1:3900/api
# FLOW_PAY_URL=http://127.0.0.1:3900/pay

# --- Datos ------------------------------------------------------------------
# Carpeta con la base SQLite y los archivos subidos. Por omisión ./data.
# En Docker la imagen ya define DATA_DIR=/app/data (volumen app_data).
# DATA_DIR=/var/lib/jardin-memorial

# Sembrar la demo en el primer arranque solo si se pide explícitamente.
SEED_DEMO=false

# Apagar el acceso de prueba de un clic. En pagos reales ya está apagado
# automáticamente, pero dejarlo explícito evita sorpresas.
DEMO_ACCESS=off

# --- Administración ---------------------------------------------------------
# Las credenciales también se pueden pegar desde /panel/admin/pagos; lo que se
# define aquí en el entorno tiene prioridad sobre lo guardado en el panel.
# Correo(s) con acceso a /panel/admin/pagos, la página que muestra el estado de
# la pasarela, las URLs a registrar y el botón "Probar credenciales".
# Sin esta variable la página responde 404 para todos.
# ADMIN_EMAILS=dueno@tudominio.cl

# --- Opcionales -------------------------------------------------------------
# Base pública alternativa (si ya usabas BASE_URL en instalaciones anteriores;
# SITE_URL tiene prioridad). No hace falta definirla.
# BASE_URL=https://memoriales.jardinmemorial.cl

# Dominio de cookie compartido entre subdominios del mismo sitio.
# COOKIE_DOMAIN=.jardinmemorial.cl

# Diagnóstico: registra método, host y referer de cada petición (sin tokens).
# DEBUG_REQUESTS=1
