# ============================================================================
# Jardín Memorial · configuración de producción
# Copia este archivo como .env (nunca lo subas al repositorio).
# ============================================================================

# --- Sitio ------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# URL pública REAL de la app (debe ser HTTPS y accesible desde internet).
# Es la que Flow usa para devolver al comprador y para notificar el pago.
SITE_URL=https://memoriales.jardinmemorial.cl

# Dominio(s) del sitio WordPress que pueden incrustar la app en un iframe.
# Varios valores separados por coma o espacio.
EMBED_ORIGINS=https://www.jardinmemorial.cl

# 1 = oculta siempre el encabezado y el pie propios de la app. Normalmente 0:
# con la plantilla de pantalla completa de WordPress la app aporta la
# navegación; si la página conserva el encabezado del tema, usa chrome="0" en
# el shortcode en lugar de esta variable.
EMBED_CHROME=0

# --- Pagos con Flow ---------------------------------------------------------
# flow  = cobros reales (requiere FLOW_API_KEY y FLOW_SECRET_KEY)
# demo  = pagos simulados, sin cargo real
PAYMENTS_MODE=flow

# sandbox = pruebas · production = cobros reales
FLOW_ENV=sandbox

# Credenciales de tu comercio Flow:
#   producción → https://www.flow.cl/app/web/misDatos.php
#   pruebas    → https://sandbox.flow.cl/app/web/misDatos.php
FLOW_API_KEY=
FLOW_SECRET_KEY=

# Solo para pruebas automatizadas con un Flow simulado. Déjalos vacíos en real.
# FLOW_API_URL=http://127.0.0.1:3900/api
# FLOW_PAY_URL=http://127.0.0.1:3900/pay

# --- Datos ------------------------------------------------------------------
# Carpeta con la base SQLite y los archivos subidos. Por omisión ./data.
# En Docker la imagen ya define DATA_DIR=/app/data (volumen app_data).
# DATA_DIR=/var/lib/jardin-memorial

# Sembrar la demo en el primer arranque solo si se pide explícitamente.
SEED_DEMO=false

# Apagar el acceso de prueba de un clic. En pagos reales ya está apagado
# automáticamente, pero dejarlo explícito evita sorpresas.
DEMO_ACCESS=off

# --- Opcionales -------------------------------------------------------------
# Base pública alternativa (si ya usabas BASE_URL en instalaciones anteriores;
# SITE_URL tiene prioridad). No hace falta definirla.
# BASE_URL=https://memoriales.jardinmemorial.cl

# Dominio de cookie compartido entre subdominios del mismo sitio.
# COOKIE_DOMAIN=.jardinmemorial.cl

# Diagnóstico: registra método, host y referer de cada petición (sin tokens).
# DEBUG_REQUESTS=1
