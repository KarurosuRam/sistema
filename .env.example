# ------------------------------------------------------------------
# Amapola · configuración de ejemplo
# Copia este archivo como .env y ajusta los valores.
# ------------------------------------------------------------------

PORT=3000

# Zona horaria del salón (afecta "hoy", disponibilidad y fechas)
TIMEZONE=America/Santiago
BUSINESS_NAME=Amapola Peluquería

# Recordatorios automáticos: si AUTO_REMINDERS=1, el servidor envía cada
# mañana (a partir de REMINDERS_HOUR) los recordatorios de las reservas del
# día siguiente, sin repetirlos.
AUTO_REMINDERS=0
REMINDERS_HOUR=10

# Reglas de reserva
SLOT_STEP_MINUTES=30
BOOKING_LEAD_MINUTES=60
BOOKING_MAX_DAYS=60

# ------------------------------------------------------------------
# WhatsApp
# Sin credenciales, el sistema funciona en "modo demostración":
# cada mensaje se registra en data/whatsapp-outbox.log y en el
# buzón de envíos del panel, sin enviarse realmente.
#
# Opción A · Meta WhatsApp Cloud API (recomendado)
#  1. Crea una app en https://developers.facebook.com/apps
#  2. Agrega el producto WhatsApp y obtén el Phone number ID y el token
#  3. Usa el número de prueba o registra el tuyo
# ------------------------------------------------------------------
# META_WHATSAPP_TOKEN=EAAG...
# META_PHONE_NUMBER_ID=123456789012345

# Opción B · Twilio WhatsApp
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=+14155238886

# Código de país por defecto para normalizar teléfonos locales
WHATSAPP_COUNTRY_CODE=56

# Carpeta de datos SQLite (por defecto ./data)
# DATA_DIR=./data
